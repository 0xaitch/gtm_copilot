# Copy to .env.local. Everything is optional for a local heuristic-only run.

# LLM (provider-agnostic). Unset → heuristic extraction/thesis fallbacks.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Farcaster via Neynar — FREE tier. Reads Farcaster bios of people whose verified X handle we found
# (website/GitHub/forum), so roles can be confirmed without the paid X API.
NEYNAR_API_KEY=
NEYNAR_MAX_LOOKUPS=15

# X API v2 — OPTIONAL, paid (pay-per-use, app-only Bearer token). Everything works without it. Enables: handle→website fallback, project posts
# (why-now + funding), team discovery (affiliates, user search, bios) and skimming key people's posts.
# Rough cost per analysis: ~$0.30–1.00 (≈$0.01/user, ≈$0.005/post). Shown in the UI per run.
X_BEARER_TOKEN=
X_MAX_PROJECT_POSTS=30
X_MAX_AFFILIATES=40
X_MAX_SEARCH_USERS=15
X_MAX_PEOPLE_LOOKUPS=30
X_SKIM_PEOPLE=3

# Supabase (persistence — not wired yet)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth — not wired yet)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# GitHub — optional; raises rate limit from 60 to 5,000 req/hour (no scopes needed)
GITHUB_TOKEN=
